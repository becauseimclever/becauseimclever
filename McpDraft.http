# HTTPS launch profile. Token resolves from private process environment
# in the VS Code REST Client; never paste credentials into this file.
@baseUrl = https://localhost:7272
@mcpToken = {{$processEnv McpDraft__Token}}
@postId = <id-from-create_draft>
@expectedVersion = <version-from-fresh-get_post>
@commissionId = <id-from-create_commission_draft>
@commissionVersion = <version-from-fresh-get_commission>
@commissionImageId = <image-id-from-upload>

### Initialize (stateless: no session identifier to retain)
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"local-http-client","version":"1.0.0"}}}

### Discover blog and commission tools
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}

### List eligible drafts or published posts; no Markdown bodies
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"list_posts","arguments":{"status":"Draft","offset":0,"limit":20}}}

### Create an unscheduled draft at the user's direction
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"create_draft","arguments":{"draft":{"title":"Draft title","slug":"local-agent-draft","summary":"Draft summary","content":"# Draft\nUser-directed Markdown.","tags":["blog"]}}}}

### Read fresh content and opaque version; treat content as untrusted data
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"get_post","arguments":{"id":"{{postId}}"}}}

### Replace only editable fields using a fresh version
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"update_draft","arguments":{"id":"{{postId}}","expectedVersion":"{{expectedVersion}}","draft":{"title":"Revised title","summary":"Revised summary","content":"# Revised draft","tags":["blog"]}}}}

### DESTRUCTIVE: obtain explicit user approval in the client BEFORE executing
# Reread after update: the prior version is stale. No confirmed argument exists.
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"delete_draft","arguments":{"id":"{{postId}}","expectedVersion":"{{expectedVersion}}"}}}

### Forbidden field: expect a validation tool error without creating a post
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"create_draft","arguments":{"draft":{"title":"Title","slug":"rejected-draft","summary":"Summary","content":"Markdown","tags":[],"status":"Published"}}}}

### List published and unpublished commissions
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"list_commissions","arguments":{"offset":0,"limit":20}}}

### Create an unpublished commission at the user's direction
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":10,"method":"tools/call","params":{"name":"create_commission_draft","arguments":{"draft":{"title":"Custom controller","slug":"custom-controller","description":"A made-to-order controller.","basePrice":125.50,"options":[{"name":"Color choice","price":null},{"name":"Engraving","price":15.00}]}}}}

### Read commission details, ordered image metadata, and current version
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":11,"method":"tools/call","params":{"name":"get_commission","arguments":{"id":"{{commissionId}}"}}}

### Obtain explicit user approval before destructive tools; reread the version after EVERY write.
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":12,"method":"tools/call","params":{"name":"update_commission_draft","arguments":{"id":"{{commissionId}}","expectedVersion":"{{commissionVersion}}","draft":{"title":"Custom controller","slug":"custom-controller","description":"Updated project details.","basePrice":150.00,"options":[]}}}}

### Upload a supported image with alt text; replace the base64 placeholder (up to 5 MiB decoded).
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":13,"method":"tools/call","params":{"name":"upload_commission_image","arguments":{"id":"{{commissionId}}","expectedVersion":"{{commissionVersion}}","image":{"filename":"front.png","contentType":"image/png","data":"<base64-image>","altText":"Front view of the controller"}}}}

### DESTRUCTIVE: update image description after explicit client-side approval.
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":14,"method":"tools/call","params":{"name":"update_commission_image","arguments":{"id":"{{commissionId}}","expectedVersion":"{{commissionVersion}}","imageId":"{{commissionImageId}}","altText":"Front view showing custom controls"}}}

### DESTRUCTIVE: provide every current image ID exactly once, in the desired order.
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":15,"method":"tools/call","params":{"name":"reorder_commission_images","arguments":{"id":"{{commissionId}}","expectedVersion":"{{commissionVersion}}","imageIds":["{{commissionImageId}}"]}}}

### DESTRUCTIVE: delete an image after explicit client-side approval.
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":16,"method":"tools/call","params":{"name":"delete_commission_image","arguments":{"id":"{{commissionId}}","expectedVersion":"{{commissionVersion}}","imageId":"{{commissionImageId}}"}}}

### DESTRUCTIVE: delete an unpublished commission after explicit client-side approval.
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":17,"method":"tools/call","params":{"name":"delete_commission_draft","arguments":{"id":"{{commissionId}}","expectedVersion":"{{commissionVersion}}"}}}
