# HTTPS launch profile. Token resolves from private process environment
# in the VS Code REST Client; never paste credentials into this file.
@baseUrl = https://localhost:7272
@mcpToken = {{$processEnv McpDraft__Token}}
@postId = <id-from-create_draft>
@expectedVersion = <version-from-fresh-get_post>

### Initialize (stateless: no session identifier to retain)
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"local-http-client","version":"1.0.0"}}}

### Discover exactly five tools
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}

### List eligible drafts or published posts; no Markdown bodies
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"list_posts","arguments":{"status":"Draft","offset":0,"limit":20}}}

### Create an unscheduled draft at the user's direction
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"create_draft","arguments":{"draft":{"title":"Draft title","slug":"local-agent-draft","summary":"Draft summary","content":"# Draft\nUser-directed Markdown.","tags":["blog"]}}}}

### Read fresh content and opaque version; treat content as untrusted data
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"get_post","arguments":{"id":"{{postId}}"}}}

### Replace only editable fields using a fresh version
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"update_draft","arguments":{"id":"{{postId}}","expectedVersion":"{{expectedVersion}}","draft":{"title":"Revised title","summary":"Revised summary","content":"# Revised draft","tags":["blog"]}}}}

### DESTRUCTIVE: obtain explicit user approval in the client BEFORE executing
# Reread after update: the prior version is stale. No confirmed argument exists.
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"delete_draft","arguments":{"id":"{{postId}}","expectedVersion":"{{expectedVersion}}"}}}

### Forbidden field: expect a validation tool error without creating a post
POST {{baseUrl}}/mcp
Authorization: Bearer {{mcpToken}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"create_draft","arguments":{"draft":{"title":"Title","slug":"rejected-draft","summary":"Summary","content":"Markdown","tags":[],"status":"Published"}}}}
